(Measure and use tool height)

; max mm movement from g30 start position to where the first
; switch should trigger
#<totriggerfirst> = -250

; max mm movement from the first switch triggering to the second
#<totriggersecond> = -50

; diameter of spindle edge, for measuring baseline when there is no tool
#<diaspindle> = -30

; pin number for enabling tool height measuring arm
#<pinenabletoolarm> = 2

; pin number switching from 0 to 1 when tool height measuring arm is fully extended
#<pintoolarmsensor> = 1

; pin number for select input for first or second tool height trigger 0=second
#<pintoolarmtrigselect> = 7

; Feed rate for quick decend towards first height trigger
#<feedfirst> = 700

; Feed rate for slow decend towards second height trigger
#<feedsecond> = 50

#<max_limit_z> = #<_ini[axis_z]max_limit>

(metric)
g21
(absolute position mode relative to coordinate system)
g90

; #<toolnum> = #<_hal[iocontrol.0.tool-number]>
#<toolnum> = #5400

(print, Setting height of tool #<toolnum>)
(cancel tool length compensation)
g49

#<zworkoffset> = [#[5203 + #5220 * 20] + #5213 * #5210]

(print, Z work offset is #<zworkoffset>)

(print, reference length at start is #1000)

(Move to the top to lift tool off workpiece)
G53 G0 Z#<max_limit_z>

(Extend tool measure arm)
M64 P#<pinenabletoolarm>
M66 P#<pintoolarmsensor> Q30
G4 P3 (Give arm time to swing, arm extended pin P#<pintoolarmsensor> show up too soon)

(move spindle above tool measure arm switch, ie G30 X+Y location, keeping height)
G53 G0 X#5181 Y#5182


(If no tool in spindle, offset Y to hit spindle edge)
(If tool in spindle, move half its diameter #5410 to the side to measure edge)
(FIXME should also orient spindle to hit cylinder, not drive dogs)
(FIXME do not work, pin spindle-tool-detector detect clamped, not presence)
G91
M66 P0 L0
(if #5399 = 1, aka no tool locked in spindle)
O10 IF [#5399 EQ 1]
  (print, Measuring spindle without tool)
  G0 Y#<diaspindle>
  #1000 = 0
O10 ELSE
  (print, Measuring height of tool #<toolnum> edge in spindle)
  G0 Y[0 - #5410 / 2]
O10 ENDIF

(print, Using first tool height trigger, approach quickly)
M64 P#<pintoolarmtrigselect>
G38.3 Z#<totriggerfirst> F#<feedfirst> (measure)
G0z.2 (off the switch)
O101 IF [#5070 EQ 0]
  (print, Probe failed, lift spindle and move away)
  G90
  G53 G0 Z#<max_limit_z>
O101 ELSE
  (print, Using first tool height trigger, approach slowly)
  G38.2 Z#<totriggersecond> F#<feedsecond> (measure)
  G0z.2 (off the switch)
  O20 IF [#1000 EQ 0]
    #1000 = [ #5063 + #<zworkoffset> ] (save reference tool length)
    (print, reference length is #1000)
  O20 ENDIF
  (print, tool trigger height #5063)
  #1001 = [#5063 + #<zworkoffset> - #1000]
  G10 L1 P#<toolnum> Z#1001 (set new tool offset)
  (debug, new #5400 tool length is #1001)
  G43
O101 ENDIF
G90

(move up before retracting tool measuring arm, to avoid scratching it)
G53 G0 Z#<max_limit_z>

M65 P#<pinenabletoolarm>

G53 G0 X0 Y0

M2
